{% if caddy_mode == "dev" %}
{
    auto_https disable_redirects
}
{% elif caddy_mode == "prod" %}
{
    email {{ caddy_email }}
    # Use acme_dns / acme_http_challenge options here if needed
}
{% endif %}

#
# === Home environment ===
#
{% if caddy_mode == "dev" %}
# Shared routes for the home VM, imported by both HTTP and local HTTPS.
(home_routes) {
    @app host app.home.org
    handle @app {
        reverse_proxy oldap-app:3000
    }

    @api host api.home.org
    handle @api {
        reverse_proxy oldap-api:8000
    }

    @fasnacht host fasnacht.home.org
    handle @fasnacht {
        reverse_proxy fasnachts-page:3100
    }

    @graphdb host graphdb.home.org
    handle @graphdb {
        # Protect GraphDB Workbench with HTTP Basic Auth
        basicauth {
            {env.GRAPHDB_BASIC_USER} {env.GRAPHDB_BASIC_HASH}
        }
        reverse_proxy graphdb:7200
    }
}

# Home Server (HTTP)
http://app.home.org, http://api.home.org, http://fasnacht.home.org, http://graphdb.home.org {
    import home_routes
}

# Home Server (local HTTPS)
https://app.home.org, https://api.home.org, https://fasnacht.home.org, https://graphdb.home.org {
    tls internal
    import home_routes
}
{% endif %}

#
# === Production environment (Let’s Encrypt) ===
#
{% if caddy_mode == "prod" %}
# API
api.oldap.org {
    # Flask owns the exact-origin, credentialed CORS policy for all requests,
    # including preflight responses.
    reverse_proxy oldap-api:8000 {
        # forward Authorization header upstream (Flask needs it)
        header_up Authorization {http.request.header.Authorization}
    }
}

# GraphDB (protected)
graphdb.oldap.org {
    encode gzip zstd

    # Protect GraphDB Workbench with HTTP Basic Auth
    basicauth {
        {env.GRAPHDB_BASIC_USER} {env.GRAPHDB_BASIC_HASH}
    }

    reverse_proxy graphdb:7200
}

# SPA / App
app.oldap.org {
    encode gzip zstd
    reverse_proxy oldap-app:3000
}

# Fasnacht page (two domains possible)
fasnacht.digital, fasnacht.oldap.org {
    encode gzip zstd
    reverse_proxy fasnachts-page:3100
}
{% endif %}
