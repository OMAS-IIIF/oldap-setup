OLDAP_HARVESTERS_TAG={{ oldap_harvesters_tag | default('latest') }}
FASNACHTS_PAGE_TAG={{ fasnachts_page_tag | default('latest') }}

# --- OLDAP environment (server) ---
APP_ENV={{ app_env | default('Prod') }}
PUBLIC_API_URL={{ public_api_url | default(api_url) }}
OLDAP_PUBLIC_APP_URL={{ oldap_public_app_url | default(public_app_url) }}
SERVER_API_URL={{ server_api_url | default('http://oldap-api:8000') }}
PUBLIC_IIIF_URL={{ public_iiif_url | default('') }}
PUBLIC_UPLOAD_URL={{ public_upload_url | default('') }}
PUBLIC_MEDIASERVER_URL={{ public_mediaserver_url | default('') }}

# GraphDB basic auth for Caddy
GRAPHDB_BASIC_USER={{ graphdb_basic_user | default('admin') }}
GRAPHDB_BASIC_HASH={{ graphdb_basic_hash | replace('$', '$$') }}
